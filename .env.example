# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_project_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
VITE_SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Email Service Configuration
VITE_EMAIL_SERVICE=gmail
VITE_EMAIL_HOST=smtp.gmail.com
VITE_EMAIL_PORT=587
VITE_EMAIL_USER=your_email@gmail.com
VITE_EMAIL_PASSWORD=your_app_password


# Application Configuration
VITE_APP_URL=http://localhost:5173
VITE_API_URL=http://localhost:5173/api

# Allowed Email Domains
VITE_ALLOWED_DOMAINS=cs.du.ac.bd,cse.du.ac.bd,du.ac.bd

# JWT Secret
VITE_JWT_SECRET=your_jwt_secret_key_here

# Frontend Port (for Vite dev server)
VITE_PORT=5173

# Backend Port (if using separate Express server)
BACKEND_PORT=3001
